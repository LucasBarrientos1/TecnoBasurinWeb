# Copiá este archivo como .env y completá los valores. NUNCA subas el .env a GitHub.
# DATABASE_URL: en Supabase > botón "Connect" > "Session pooler" (funciona con IPv4, necesario en Render).
DATABASE_URL=postgresql://postgres.TU_PROJECT_REF:TU_CLAVE@aws-0-TU_REGION.pooler.supabase.com:5432/postgres
DB_SSL=true
# JWT_SECRET: pegá el RESULTADO (no el comando) de:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET= pega_aqui_el_resultado_del_comando
PORT=3000
